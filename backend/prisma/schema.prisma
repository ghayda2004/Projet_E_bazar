// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Basic E-commerce models
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  category    String
  categoryId  String
  image       String?
  emoji       String?
  rating      Float    @default(0)
  discount    Int?
  sellerId    Int
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  name       String
  password   String
  role       String    // 'client' or 'vendeur'
  phone      String?
  storeName  String?   // For vendors only
  address    String?   // For vendors only
  storePhoto String?   // For vendors only
  products   Product[] // Relation to products for sellers
  orders     Order[]   // Orders placed by user
  soldOrders Order[]   @relation("SellerOrders") // Orders received by seller
  createdAt  DateTime  @default(now())
}

model Order {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId   Int
  seller     User       @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  total      Float
  status     String     @default("pending") // pending, confirmed, shipped, delivered, cancelled
  items      OrderItem[]
  createdAt  DateTime   @default(now())
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  Int
  name       String
  price      Float
  quantity   Int
  image      String?
  createdAt  DateTime @default(now())
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("unread") // unread, read
  createdAt DateTime @default(now())
}
